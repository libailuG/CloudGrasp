<sdf version="1.9">
  <model name="camera">
    <static>true</static>
    <pose>0.45 0.05 1.1 0 1.57079632679 0</pose>
    <link name="link">
      <sensor name="rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>0.85</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>2.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>