Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: world
    Background Color: 35; 40; 50
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
      Plane Cell Count: 20
      Cell Size: 0.1
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Planning Group: ur_manipulator
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Scene Robot:
        Robot Alpha: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: RGBD Camera
      Enabled: true
      Topic:
        Value: /camera/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (Pixels): 2
      Style: Points
      Color Transformer: RGB8
    - Class: rviz_default_plugins/PointCloud2
      Name: Detected Object
      Enabled: true
      Topic:
        Value: /object_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (Pixels): 5
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 255; 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.25
      Pitch: 0.65
      Yaw: 0.7
Window Geometry:
  Width: 1100
  Height: 780
